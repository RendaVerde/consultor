# Pasta que contém produtos.xlsx e os oito planogramas.
GOOGLE_DRIVE_FOLDER_ID=1hpXiYOyCnHzx9Jfk67_PZPGvzu8gsyBU

# Opção recomendada: cole o conteúdo completo do JSON da conta de serviço.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Para desenvolvimento local, pode-se apontar para o JSON guardado fora do projeto.
GOOGLE_SERVICE_ACCOUNT_FILE=

# Alternativa ao JSON completo. Preencha os dois valores abaixo.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Criado automaticamente quando um Vercel Blob privado é conectado ao projeto.
BLOB_READ_WRITE_TOKEN=

# Senha escolhida por você para proteger o botão de atualização.
IHM_SYNC_TOKEN=

# Acesso ao Consultor. A senha é armazenada apenas como hash PBKDF2.
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=

# Segredo aleatório com pelo menos 32 caracteres para assinar os cookies.
AUTH_SESSION_SECRET=

# Na Vercel, cadastre estes valores em Project Settings > Environment Variables.
